{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kyokumen Igo third-party software catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "checkedOn",
    "repository",
    "projectSourceLicense",
    "scope",
    "entries",
    "inventoryFiles",
    "noticeSnapshots",
    "references"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "checkedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://"
    },
    "scope": {
      "type": "string"
    },
    "projectSourceLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["licenseExpression", "licenseFile", "distributionFile", "scope"],
      "properties": {
        "licenseExpression": {"type": "string"},
        "licenseFile": {"type": "string"},
        "distributionFile": {"type": "string"},
        "scope": {"type": "string"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "inventoryFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "python"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "python": {
          "type": "string"
        }
      }
    },
    "noticeSnapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notice"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "category",
        "relationship",
        "licenseExpression",
        "usage",
        "files",
        "urls",
        "notices",
        "copyrightNotices",
        "modifications",
        "distribution",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "enum": [
            "reference",
            "runtime",
            "tool"
          ]
        },
        "relationship": {
          "enum": [
            "adapted",
            "implementation-reference",
            "dependency",
            "static-link",
            "build-tool",
            "coding-agent"
          ]
        },
        "licenseExpression": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "type": "string"
        },
        "files": {
          "$ref": "#/$defs/strings"
        },
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https?://"
          }
        },
        "notices": {
          "$ref": "#/$defs/strings"
        },
        "copyrightNotices": {
          "$ref": "#/$defs/strings"
        },
        "modifications": {
          "$ref": "#/$defs/strings"
        },
        "distribution": {
          "enum": [
            "wasm",
            "runtime-files",
            "development-only",
            "reference"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "evidence",
            "ref",
            "gitBlobSha"
          ],
          "properties": {
            "kind": {
              "enum": [
                "documented-reference",
                "implementation-match",
                "package",
                "toolchain",
                "tool"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/strings"
            },
            "ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "gitBlobSha": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "url",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "gitBlobSha": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "authors",
        "year",
        "url",
        "usage"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "usage": {
          "type": "string"
        }
      }
    }
  }
}
