+// Install only the experimental slot; this never promotes a model to production.
+import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';
+import {resolve,join} from 'node:path';
+import {createHash} from 'node:crypto';
+import {validateManifest} from '../../dist/ai-v3-inference.js';
+const source=resolve(process.argv[2]??'tools/ai-gnn/target/model');
+const manifest=JSON.parse(readFileSync(join(source,'manifest.json'),'utf8'));validateManifest(manifest);
+const bytes=readFileSync(join(source,manifest.model));
+if(createHash('sha256').update(bytes).digest('hex')!==manifest.sha256)throw new Error('Invalid model checksum');
+const destination=new URL('../../dist/models/v3/',import.meta.url);mkdirSync(destination,{recursive:true});
+writeFileSync(new URL('model.onnx',destination),bytes);
+writeFileSync(new URL('manifest.json',destination),JSON.stringify(manifest,null,2)+'\n');
+const golden=JSON.parse(readFileSync(join(source,'golden.json'),'utf8'));golden.modelSha256=manifest.sha256;
+writeFileSync(new URL('../../tests/fixtures/ai/v3-golden.json',import.meta.url),JSON.stringify(golden)+'\n');
+console.log('Installed experimental v3 model: '+manifest.parameters+' parameters, '+bytes.length+' bytes.');
diff --git a/tools/ai-gnn/model.py b/tools/ai-gnn/model.py
new file mode 100644
index 0000000..c162371
--- /dev/null
+++ b/tools/ai-gnn/model.py
@@ -0,0 +1,47 @@
+"""v3: permutation-equivariant, 64-channel / six-block residual graph network."""
+import torch
+from torch import nn
+
+POINTS, CHANNELS, GLOBALS, HIDDEN, BLOCKS = 160, 32, 8, 64, 6
+
+
+def pool(h, mask):
+    return (h * mask).sum(1) / mask.sum(1).clamp_min(1)
+
+
+class Block(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.local = nn.Linear(HIDDEN, HIDDEN)
+        self.near = nn.Linear(HIDDEN, HIDDEN, bias=False)
+        self.context = nn.Linear(HIDDEN + GLOBALS, HIDDEN)
+        self.out = nn.Linear(HIDDEN, HIDDEN)
+
+    def forward(self, h, adjacency, mask, global_features):
+        g = torch.cat((pool(h, mask), global_features), -1)
+        z = torch.relu(self.local(h) + self.near(adjacency @ h) + self.context(g).unsqueeze(1))
+        return (h + 0.25 * self.out(z)) * mask
+
+
+def head(inputs, outputs, width=32):
+    return nn.Sequential(nn.Linear(inputs, width), nn.ReLU(), nn.Linear(width, outputs))
+
+
+class GraphNet(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.input = nn.Linear(CHANNELS, HIDDEN)
+        self.blocks = nn.ModuleList(Block() for _ in range(BLOCKS))
+        self.policy = head(HIDDEN, 1)
+        self.passing = head(HIDDEN + GLOBALS, 1)
+        self.value = head(HIDDEN + GLOBALS, 3, 64)
+        self.score = head(HIDDEN + GLOBALS, 1, 64)
+        self.ownership = head(HIDDEN, 3)
+
+    def forward(self, x, adjacency, mask, global_features):
+        h = torch.relu(self.input(x)) * mask
+        for block in self.blocks:
+            h = block(h, adjacency, mask, global_features)
+        g = torch.cat((pool(h, mask), global_features), -1)
+        policy = torch.cat((self.policy(h).squeeze(-1), self.passing(g)), -1)
+        return policy, self.value(g), self.score(g).squeeze(-1), self.ownership(h)
diff --git a/tools/ai-gnn/node-inference.mjs b/tools/ai-gnn/node-inference.mjs
new file mode 100644
index 0000000..6b82d90
--- /dev/null
+++ b/tools/ai-gnn/node-inference.mjs
@@ -0,0 +1,19 @@
+import * as ort from 'onnxruntime-node';
+import {readFileSync} from 'node:fs';
+import {createHash} from 'node:crypto';
+import {resolve,join} from 'node:path';
+import {validateManifest} from '../../dist/ai-v3-inference.js';
+export async function createNodeInference(directory){
+ directory=resolve(directory);const manifest=JSON.parse(readFileSync(join(directory,'manifest.json'),'utf8'));
+ validateManifest(manifest);const bytes=readFileSync(join(directory,manifest.model));
+ if(createHash('sha256').update(bytes).digest('hex')!==manifest.sha256)throw new Error('v3 model checksum mismatch');
+ const session=await ort.InferenceSession.create(bytes,{executionProviders:['cpu'],intraOpNumThreads:4});
+ return {manifest,async evaluate(request,adjacency,{auxiliary=false}={}){
+  const n=request.count;
+  const outputs=await session.run({x:new ort.Tensor('float32',request.x,[n,160,32]),
+   adjacency:new ort.Tensor('float32',adjacency,[1,160,160]),mask:new ort.Tensor('float32',request.mask,[n,160,1]),
+   global_features:new ort.Tensor('float32',request.global_features,[n,8])},auxiliary?['policy','wdl','score','ownership']:['policy','wdl']);
+  const result=Object.fromEntries(Object.entries(outputs).map(([key,t])=>[key,Float32Array.from(t.data)]));
+  for(const t of Object.values(outputs))t.dispose();return result;
+ },async dispose(){await session.release();}};
+}
