diff --git a/tools/ai-tuner/gnn-data.rs b/tools/ai-tuner/gnn-data.rs
new file mode 100644
index 0000000..a4ac677
--- /dev/null
+++ b/tools/ai-tuner/gnn-data.rs
@@ -0,0 +1,50 @@
+//! Bootstrap data from the actual v2 teacher. Capped games never become training labels.
+#[path="src/board.rs"] mod board;
+#[path="src/ai.rs"] mod ai;
+#[path="src/rng.rs"] mod rng;
+#[path="src/search.rs"] mod search;
+#[path="src/gnn.rs"] mod gnn;
+use board::{Game,Kind,Scratch,Topology};
+use std::io::{Write,BufWriter};
+
+fn main() {
+    let args:Vec<_>=std::env::args().collect();
+    assert!(args.len()>=3,"usage: gnn-data OUT.jsonl GAMES_PER_BOARD [SEED]");
+    let games:usize=args[2].parse().unwrap(); assert!(games>0);
+    let seed:u64=args.get(3).map_or(20261021,|s|s.parse().unwrap());
+    let mut rng=rng::Rng::new(seed);
+    let mut out=BufWriter::new(std::fs::File::create(&args[1]).unwrap());
+    let mut count=0;let mut capped=0;
+    for (config,(kind,size)) in [(Kind::Sphere,3),(Kind::Sphere,4),(Kind::Sphere,5),(Kind::Torus,7),(Kind::Torus,9),(Kind::Torus,11)].into_iter().enumerate() {
+        let t=Topology::new(kind,size);
+        for k in 0..games {
+            let komi=[0.,3.5,6.5,9.5][k%4];
+            let mut game=Game::new(&t,komi);let mut scratch=Scratch::new(t.len());let mut past=vec![];let mut samples=vec![];
+            while !game.ended&&game.history.len()<t.len()*20 {
+                let features=gnn::encode(&game,&past,kind==Kind::Sphere);
+                let teacher=search::choose_search(&game,4,rng.next_u64() as u32).0;
+                // Slightly diversify openings while retaining the teacher's actual target.
+                let played=if game.history.len()<6&&rng.f64()<0.25 {
+                    let legal:Vec<_>=features.legal[..t.len()].iter().enumerate().filter(|(_,v)|**v).map(|(i,_)|i).collect();
+                    if legal.is_empty(){teacher}else{Some(legal[rng.next_u64() as usize%legal.len()])}
+                }else{teacher};
+                samples.push((features,teacher,game.turn));
+                gnn::remember(&mut past,&game.board);
+                assert!(match played {Some(p)=>game.play(p,&mut scratch),None=>game.pass()});
+            }
+            if !game.ended {capped+=1;continue;}
+            let (b,w)=game.score();let owners=gnn::ownership(&game);
+            for (f,teacher,turn) in samples {
+                let value=if b==w{1}else if (b>w)==(turn==1){0}else{2};
+                let own:Vec<_>=owners.iter().map(|&s|if s==0{1}else if s==turn{0}else{2}).collect();
+                let margin=(b-w)*if turn==1{1.}else{-1.};
+                writeln!(out,"{{\"schemaVersion\":1,\"gameId\":\"{seed}-{config}-{k}\",\"kind\":\"{}\",\"size\":{},\"x\":{:?},\"global\":{:?},\"legal\":{:?},\"action\":{},\"wdl\":{},\"score\":{},\"ownership\":{:?}}}",
+                    kind.name(),size,&f.x[..t.len()*gnn::CHANNELS],f.global,f.legal,teacher.unwrap_or(gnn::PASS),value,margin,own).unwrap();
+                count+=1;
+            }
+            eprintln!("{} {} game {}/{}: {} moves",kind.name(),size,k+1,games,game.history.len());
+        }
+    }
+    out.flush().unwrap();
+    eprintln!("wrote {count} positions; excluded {capped} capped games; seed {seed}");
+}
diff --git a/tools/ai-tuner/src/gnn-wasm.rs b/tools/ai-tuner/src/gnn-wasm.rs
new file mode 100644
index 0000000..8ac64d5
--- /dev/null
+++ b/tools/ai-tuner/src/gnn-wasm.rs
@@ -0,0 +1,79 @@
+//! Separate v3 module; the deployed v2 ABI and binary remain independent.
+mod ai; mod board; mod rng; mod gnn; mod mcts;
+use std::cell::RefCell;
+use board::{Game,Kind,Scratch,Topology};
+use gnn::{ACTIONS,GLOBALS,CHANNELS,POINTS};
+
+struct Engine {
+    topology: Topology, sphere: bool, komi: f64, moves: Vec<i32>, search: mcts::Search,
+    ids: Vec<u32>, x: Vec<f32>, globals: Vec<f32>, masks: Vec<f32>, legal: Vec<f32>, policy: Vec<f32>,
+}
+thread_local! {static ENGINE: RefCell<Option<Engine>>=const {RefCell::new(None)};}
+fn restore<'a>(t:&'a Topology,komi:f64,moves:&[i32])->Option<(Game<'a>,Vec<Vec<i8>>)> {
+    let mut game=Game::new(t,komi); let mut past=vec![]; let mut scratch=Scratch::new(t.len());
+    for &m in moves {
+        gnn::remember(&mut past,&game.board);
+        if !(if m == -1 {game.pass()} else if m>=0 {game.play(m as usize,&mut scratch)} else {false}) {return None;}
+    }
+    Some((game,past))
+}
+#[no_mangle] pub extern "C" fn v3_version()->u32 {1}
+#[no_mangle] pub extern "C" fn v3_alloc(words:usize)->*mut u32 {
+    if words==0||words>1_000_000 {return std::ptr::null_mut();}
+    Box::into_raw(vec![0u32;words].into_boxed_slice()) as *mut u32
+}
+#[no_mangle] pub unsafe extern "C" fn v3_free(ptr:*mut u32,words:usize) {
+    drop(Box::from_raw(std::ptr::slice_from_raw_parts_mut(ptr,words)));
+}
+#[no_mangle] pub unsafe extern "C" fn v3_start(kind:u32,size:usize,komi:f64,ptr:*const i32,len:usize,seed:u32)->i32 {
+    ENGINE.with(|slot| {
+        *slot.borrow_mut()=None;
+        if ptr.is_null()||len>10000||!komi.is_finite()||!matches!((kind,size),(0,3..=5)|(1,7|9|11)) {return -2;}
+        let moves=std::slice::from_raw_parts(ptr,len).to_vec();
+        let topology=Topology::new(if kind==0 {Kind::Sphere}else{Kind::Torus},size);
+        if restore(&topology,komi,&moves).is_none() {return -3;}
+        *slot.borrow_mut()=Some(Engine {topology,sphere:kind==0,komi,moves,search:mcts::Search::new(seed as u64),
+            ids:vec![],x:vec![],globals:vec![],masks:vec![],legal:vec![],policy:vec![0.;ACTIONS]});
+        0
+    })
+}
+#[no_mangle] pub extern "C" fn v3_collect(batch:usize)->i32 {
+    ENGINE.with(|slot| {
+        let mut slot=slot.borrow_mut(); let Some(e)=slot.as_mut() else{return -2;};
+        if !(1..=8).contains(&batch)||!e.ids.is_empty() {return -2;}
+        let (game,past)=restore(&e.topology,e.komi,&e.moves).unwrap();
+        let leaves=e.search.collect(&game,&past,e.sphere,batch);
+        e.x.clear();e.globals.clear();e.masks.clear();e.legal.clear();
+        for leaf in leaves {
+            e.ids.push(leaf.id);e.x.extend(leaf.features.x);e.globals.extend(leaf.features.global);
+            e.masks.extend(leaf.features.mask);e.legal.extend(leaf.features.legal.iter().map(|&v|if v{1.}else{0.}));
+        }
+        debug_assert_eq!(e.x.len(),e.ids.len()*POINTS*CHANNELS);
+        debug_assert_eq!(e.globals.len(),e.ids.len()*GLOBALS);
+        e.ids.len() as i32
+    })
+}
+#[no_mangle] pub extern "C" fn v3_buffer(kind:u32)->*const u8 {
+    ENGINE.with(|slot| {let slot=slot.borrow();let Some(e)=slot.as_ref() else{return std::ptr::null();};
+        match kind {0=>e.x.as_ptr() as _,1=>e.globals.as_ptr() as _,2=>e.masks.as_ptr() as _,
+            3=>e.legal.as_ptr() as _,4=>e.ids.as_ptr() as _,5=>e.policy.as_ptr() as _,_=>std::ptr::null()}
+    })
+}
+#[no_mangle] pub unsafe extern "C" fn v3_submit(ids:*const u32,eval:*const f32,count:usize)->i32 {
+    ENGINE.with(|slot| {let mut slot=slot.borrow_mut();let Some(e)=slot.as_mut() else{return -2;};
+        if ids.is_null()||eval.is_null()||count!=e.ids.len()||count>8 {return -2;}
+        if e.search.submit(std::slice::from_raw_parts(ids,count),std::slice::from_raw_parts(eval,count*(ACTIONS+1))).is_err(){return -3;}
+        e.ids.clear();0
+    })
+}
+#[no_mangle] pub extern "C" fn v3_best()->i32 {
+    ENGINE.with(|slot| {let mut slot=slot.borrow_mut();let Some(e)=slot.as_mut() else{return -2;};
+        e.policy=e.search.policy();e.search.best()
+    })
+}
+#[no_mangle] pub extern "C" fn v3_completed()->u32 {
+    ENGINE.with(|slot|slot.borrow().as_ref().map_or(0,|e|e.search.completed))
+}
+#[no_mangle] pub extern "C" fn v3_cancel() {
+    ENGINE.with(|slot| {if let Some(e)=slot.borrow_mut().as_mut(){e.search.cancel();e.ids.clear();}})
+}
diff --git a/tools/ai-tuner/src/gnn.rs b/tools/ai-tuner/src/gnn.rs
new file mode 100644
index 0000000..7ccb3f2
--- /dev/null
+++ b/tools/ai-tuner/src/gnn.rs
@@ -0,0 +1,96 @@
+//! v3 feature ABI. All colours are relative to the player to move.
+use crate::board::{Game, Scratch};
+
+pub const POINTS: usize = 160;
+pub const CHANNELS: usize = 32;
+pub const GLOBALS: usize = 8;
+pub const ACTIONS: usize = POINTS + 1;
+pub const PASS: usize = POINTS;
+
+#[derive(Clone)]
+pub struct Features {
+    pub x: Vec<f32>,
+    pub global: [f32; GLOBALS],
+    pub mask: Vec<f32>,
+    pub legal: Vec<bool>,
+}
+
+/// `past` contains up to four previous boards, oldest first, excluding the current board.
+pub fn encode(game: &Game, past: &[Vec<i8>], sphere: bool) -> Features {
+    let n = game.board.len();
+    assert!(n <= POINTS);
+    let mut f = Features {
+        x: vec![0.; POINTS * CHANNELS], mask: vec![0.; POINTS],
+        global: [0.; GLOBALS], legal: vec![false; ACTIONS],
+    };
+    let mut scratch = Scratch::new(n);
+    let mut seen = vec![false; n];
+    for p in 0..n {
+        f.mask[p] = 1.;
+        let stone = game.board[p];
+        let offset = if stone == 0 { 2 } else if stone == game.turn { 0 } else { 1 };
+        f.x[p * CHANNELS + offset] = 1.;
+        f.x[p * CHANNELS + 13 + usize::from(game.topology.neighbors[p].len() == 4)] = 1.;
+        let adjacent = &game.topology.neighbors[p];
+        f.x[p * CHANNELS + 30] = adjacent.iter().filter(|&&q| game.board[q] == game.turn).count() as f32 / 4.;
+        f.x[p * CHANNELS + 31] = adjacent.iter().filter(|&&q| game.board[q] == 3-game.turn).count() as f32 / 4.;
+        if stone != 0 && !seen[p] {
+            let libs = scratch.group(&game.board, &game.topology.neighbors, p);
+            let side = usize::from(stone != game.turn);
+            let size = (scratch.stones.len() as f32).ln_1p() / (n as f32).ln_1p();
+            for &q in &scratch.stones {
+                seen[q] = true;
+                f.x[q * CHANNELS + 3 + side * 4 + libs.clamp(1,4)-1] = 1.;
+                f.x[q * CHANNELS + 11 + side] = size;
+            }
+        }
+        if let Some(a) = game.analyze(p, &mut scratch) {
+            f.legal[p] = true;
+            f.x[p * CHANNELS + 27] = 1.;
+            f.x[p * CHANNELS + 28] = (a.captured as f32 / n as f32).sqrt();
+            f.x[p * CHANNELS + 29] = a.liberties.min(8) as f32 / 8.;
+        }
+    }
+    for (k,point) in game.history.iter().rev().take(4).enumerate() {
+        if let Some(p) = point { f.x[p * CHANNELS + 15 + k] = 1.; }
+    }
+    for (k,board) in past.iter().rev().take(4).enumerate() {
+        assert_eq!(board.len(), n);
+        for (p,&stone) in board.iter().enumerate() {
+            if stone != 0 { f.x[p * CHANNELS + 19 + 2*k + usize::from(stone != game.turn)] = 1.; }
+        }
+    }
+    f.legal[PASS] = !game.ended;
+    let sign = if game.turn == 1 { 1. } else { -1. };
+    f.global = [-sign * game.komi as f32 / n as f32, n as f32 / POINTS as f32,
+        if sphere {1.} else {0.}, if sphere {0.} else {1.},
+        game.passes.min(2) as f32 / 2., (game.history.len() as f32 / (2*n) as f32).min(2.),
+        if game.turn == 1 {1.} else {0.}, 1.];
+    f
+}
+
+pub fn remember(past: &mut Vec<Vec<i8>>, board: &[i8]) {
+    past.push(board.to_vec());
+    if past.len() > 4 { past.remove(0); }
+}
+
+/// Exact area ownership, including stones still on the board. 0 denotes neutral.
+pub fn ownership(game: &Game) -> Vec<i8> {
+    let mut result = game.board.clone();
+    let mut seen = vec![false; result.len()];
+    for p in 0..result.len() {
+        if game.board[p] != 0 || seen[p] { continue; }
+        let mut region = vec![p]; let mut borders = 0; seen[p] = true;
+        let mut k = 0;
+        while k < region.len() {
+            for &q in &game.topology.neighbors[region[k]] {
+                if game.board[q] != 0 { borders |= 1 << game.board[q]; }
+                else if !seen[q] { seen[q] = true; region.push(q); }
+            }
+            k += 1;
+        }
+        let owner = if borders == 2 {1} else if borders == 4 {2} else {0};
+        for q in region { result[q] = owner; }
+    }
+    result
+}
diff --git a/tools/ai-tuner/src/mcts.rs b/tools/ai-tuner/src/mcts.rs
new file mode 100644
index 0000000..65d036b
--- /dev/null
+++ b/tools/ai-tuner/src/mcts.rs
@@ -0,0 +1,153 @@
+//! Batched PUCT with path reservations. No transposition merging: superko is path-dependent.
+use crate::board::{Game, Scratch};
+use crate::gnn::{self, Features, ACTIONS, PASS};
+use crate::rng::Rng;
+
+const MAX_NODES: usize = 8192;
+#[derive(Default)]
+struct Node {
+    visits: u32, sum: f32, reserved: u32, pending: bool, expanded: bool, edges: Vec<Edge>,
+}
+struct Edge { action: usize, prior: f32, child: Option<usize> }
+struct Pending { id: u32, path: Vec<usize>, legal: Vec<bool> }
+pub struct Leaf { pub id: u32, pub features: Features }
+pub struct Search {
+    nodes: Vec<Node>, pending: Vec<Pending>, next_id: u32, rng: Rng,
+    pub completed: u32,
+}
+impl Search {
+    pub fn new(seed: u64) -> Self {
+        Self { nodes: vec![Node::default()], pending: vec![], next_id: 1, rng: Rng::new(seed), completed: 0 }
+    }
+    fn backup(&mut self, path: &[usize], mut value: f32, reserved: bool) {
+        for &p in path.iter().rev() {
+            let node = &mut self.nodes[p];
+            if reserved { node.reserved -= 1; }
+            node.visits += 1; node.sum += value; value = -value;
+        }
+        self.completed += 1;
+    }
+    pub fn collect(&mut self, root: &Game, past: &[Vec<i8>], sphere: bool, batch: usize) -> Vec<Leaf> {
+        assert!(self.pending.is_empty(), "submit or cancel the outstanding batch first");
+        let mut leaves = vec![];
+        if root.ended { return leaves; }
+        let mut scratch = Scratch::new(root.board.len());
+        // Bounded CPU work, including runs that repeatedly reach terminal positions.
+        for _ in 0..batch.clamp(1,8)*16 {
+            if leaves.len() == batch.clamp(1,8) { break; }
+            let mut game = root.clone(); let mut boards = past.to_vec();
+            let mut path = vec![0];
+            for _ in 0..256 {
+                let p = *path.last().unwrap();
+                if game.ended {
+                    let (b,w) = game.score();
+                    let value = if b==w {0.} else if (b>w)==(game.turn==1) {1.} else {-1.};
+                    self.backup(&path, value, false); break;
+                }
+                if self.nodes[p].pending { break; }
+                if !self.nodes[p].expanded {
+                    let features = gnn::encode(&game, &boards, sphere);
+                    let id = self.next_id; self.next_id += 1;
+                    for &q in &path { self.nodes[q].reserved += 1; }
+                    self.nodes[p].pending = true;
+                    self.pending.push(Pending {id, path, legal: features.legal.clone()});
+                    leaves.push(Leaf {id, features}); break;
+                }
+                let node = &self.nodes[p];
+                let scale = ((node.visits + node.reserved + 1) as f32).sqrt();
+                let mut best = 0; let mut best_score = f32::NEG_INFINITY;
+                for (k,e) in node.edges.iter().enumerate() {
+                    let (n,q) = e.child.map_or((0,0.), |c| {
+                        let child = &self.nodes[c];
+                        (child.visits + child.reserved, -(child.sum + child.reserved as f32) / (child.visits + child.reserved).max(1) as f32)
+                    });
+                    let score = q + 1.5 * e.prior * scale / (1+n) as f32;
+                    if score > best_score { best = k; best_score = score; }
+                }
+                let action = self.nodes[p].edges[best].action;
+                gnn::remember(&mut boards, &game.board);
+                assert!(if action == PASS {game.pass()} else {game.play(action, &mut scratch)});
+                let child = match self.nodes[p].edges[best].child {
+                    Some(c) => c,
+                    None => {
+                        if self.nodes.len() >= MAX_NODES { break; }
+                        let c = self.nodes.len(); self.nodes.push(Node::default());
+                        self.nodes[p].edges[best].child = Some(c); c
+                    }
+                };
+                path.push(child);
+            }
+        }
+        leaves
+    }
+    pub fn submit(&mut self, ids: &[u32], evaluations: &[f32]) -> Result<(), &'static str> {
+        if ids.len()!=self.pending.len() || evaluations.len()!=ids.len()*(ACTIONS+1)
+            || ids.iter().zip(&self.pending).any(|(&a,b)|a!=b.id)
+            || evaluations.iter().any(|v|!v.is_finite())
+            || evaluations.chunks_exact(ACTIONS+1).any(|e|e[ACTIONS].abs()>1.00001) {
+            return Err("Invalid or stale v3 evaluations");
+        }
+        for (pending,eval) in std::mem::take(&mut self.pending).into_iter().zip(evaluations.chunks_exact(ACTIONS+1)) {
+            let count = pending.legal.iter().filter(|&&v|v).count();
+            let max = eval[..ACTIONS].iter().zip(&pending.legal).filter(|(_,l)|**l).map(|(&v,_)|v).fold(f32::NEG_INFINITY,f32::max);
+            let total: f32 = eval[..ACTIONS].iter().zip(&pending.legal).filter(|(_,l)|**l).map(|(&v,_)|(v-max).exp()).sum();
+            let mut edges: Vec<Edge> = pending.legal.iter().enumerate().filter(|(_,l)|**l).map(|(a,_)| {
+                Edge {action:a, prior:0.98*(eval[a]-max).exp()/total + 0.02/count as f32, child:None}
+            }).collect();
+            // Seeded tie-breaking without vertex-number preference on symmetric openings.
+            for k in (1..edges.len()).rev() { let j = (self.rng.next_u64() % (k+1) as u64) as usize; edges.swap(k,j); }
+            let leaf = *pending.path.last().unwrap();
+            self.nodes[leaf].pending = false; self.nodes[leaf].expanded = true; self.nodes[leaf].edges = edges;
+            self.backup(&pending.path, eval[ACTIONS].clamp(-1.,1.), true);
+        }
+        Ok(())
+    }
+    pub fn cancel(&mut self) {
+        for pending in std::mem::take(&mut self.pending) {
+            for p in pending.path { self.nodes[p].reserved -= 1; self.nodes[p].pending = false; }
+        }
+    }
+    pub fn policy(&self) -> Vec<f32> {
+        let mut result = vec![0.; ACTIONS];
+        for e in &self.nodes[0].edges { result[e.action] = e.child.map_or(0.,|c|self.nodes[c].visits as f32); }
+        let total: f32 = result.iter().sum();
+        if total>0. { for v in &mut result {*v/=total;} }
+        else { for e in &self.nodes[0].edges {result[e.action]=e.prior;} }
+        result
+    }
+    pub fn best(&self) -> i32 {
+        let policy = self.policy();
+        let action = self.nodes[0].edges.iter().max_by(|a,b|policy[a.action].total_cmp(&policy[b.action])).map_or(PASS,|e|e.action);
+        if action==PASS {-1} else {action as i32}
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::board::{Topology,Kind};
+    #[test]
+    fn reservations_validation_and_exact_terminal_signs() {
+        for komi in [-6.5,0.,6.5] {
+            let t=Topology::new(Kind::Torus,7); let mut g=Game::new(&t,komi); g.pass();
+            let mut s=Search::new(3);
+            for _ in 0..40 {
+                let leaves=s.collect(&g,&[vec![0;49]],false,8);
+                let ids:Vec<_>=leaves.iter().map(|l|l.id).collect();
+                let mut eval=vec![-10.;ids.len()*(ACTIONS+1)];
+                for e in eval.chunks_exact_mut(ACTIONS+1) {e[PASS]=10.; e[ACTIONS]=0.;}
+                if !ids.is_empty() {
+                    let mut bad=eval.clone(); bad[0]=f32::NAN;
+                    assert!(s.submit(&ids,&bad).is_err());
+                    assert!(s.submit(&ids,&eval).is_ok());
+                }
+            }
+            assert!(s.nodes.iter().all(|n|n.reserved==0&&!n.pending));
+            if komi>0. {assert_eq!(s.best(),-1);}
+            if komi<0. {assert_ne!(s.best(),-1);}
+            let leaves=s.collect(&g,&[],false,8); s.cancel();
+            assert!(s.submit(&leaves.iter().map(|l|l.id).collect::<Vec<_>>(),&[]).is_err() || leaves.is_empty());
+            assert!(s.nodes.iter().all(|n|n.reserved==0));
+        }
+    }
+}
diff --git a/v3-tests.mjs b/v3-tests.mjs
new file mode 100644
index 0000000..7153532
--- /dev/null
+++ b/v3-tests.mjs
@@ -0,0 +1,77 @@
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {Game,createTopology} from './dist/engine.js';
+import {aiPosition} from './dist/ai-position.js';
+import {createV3Search} from './dist/ai-v3-search.js';
+const ai=await createV3Search({load:async()=>readFileSync(new URL('./dist/ai-v3.wasm',import.meta.url))});
+const fixture=(kind,size,moves,komi=6.5)=>{
+ const game=new Game(createTopology(kind,size),komi);
+ for(const m of moves)assert.equal((m<0?game.pass():game.play(m)).ok,true);return game;
+};
+function reference(game){
+ const x=new Float32Array(160*32),legal=new Float32Array(161),mask=new Float32Array(160),n=game.board.length;
+ for(let p=0;p<n;p++){
+  mask[p]=1;const stone=game.board[p],ns=game.topology.neighbors[p];
+  x[p*32+(stone===0?2:stone===game.turn?0:1)]=1;x[p*32+13+(ns.length===4?1:0)]=1;
+  x[p*32+30]=ns.filter(q=>game.board[q]===game.turn).length/4;
+  x[p*32+31]=ns.filter(q=>game.board[q]===3-game.turn).length/4;
+  if(stone){
+   const stones=[p],seen=new Set(stones),libs=new Set();
+   for(let k=0;k<stones.length;k++)for(const q of game.topology.neighbors[stones[k]]){
+    if(!game.board[q])libs.add(q);else if(game.board[q]===stone&&!seen.has(q)){seen.add(q);stones.push(q);}
+   }
+   const side=stone===game.turn?0:1;
+   x[p*32+3+side*4+Math.min(4,Math.max(1,libs.size))-1]=1;
+   x[p*32+11+side]=Math.log1p(stones.length)/Math.log1p(n);
+  }
+  const move=game.analyze(p);
+  if(move.ok){legal[p]=1;x[p*32+27]=1;x[p*32+28]=Math.sqrt(move.captured/n);x[p*32+29]=Math.min(8,move.liberties)/8;}
+ }
+ game.history.slice(1).reverse().slice(0,4).forEach((s,k)=>{if(s.lastMove!==null)x[s.lastMove*32+15+k]=1;});
+ game.history.slice(0,-1).reverse().slice(0,4).forEach((s,k)=>s.board.forEach((v,p)=>{
+  if(v)x[p*32+19+2*k+(v===game.turn?0:1)]=1;
+ }));
+ legal[160]=game.ended?0:1;
+ return {x,legal,mask};
+}
+const cases=[
+ ...[['sphere',3],['sphere',4],['sphere',5],['torus',7],['torus',9],['torus',11]].map(([kind,size])=>fixture(kind,size,[0,2,5])),
+ fixture('torus',7,[17,24,31,18,23,32,0,26,25],.5),
+ fixture('torus',7,[1,0,7,48,-1]),
+ fixture('torus',7,[17,24,18,25,19,26,31,0,32,1,33,2,23,3]),
+];
+for(const game of cases){
+ const before=JSON.stringify(game.toJSON());ai.start(aiPosition(game));const batch=ai.collect(8),expected=reference(game);
+ assert.equal(batch.count,1);
+ for(const name of ['x','mask','legal']){
+  assert.equal(batch[name].length,expected[name].length);
+  for(let k=0;k<expected[name].length;k++)assert.ok(Math.abs(batch[name][k]-expected[name][k])<2e-7,name+' '+k);
+ }
+ assert.equal(JSON.stringify(game.toJSON()),before);
+ assert.throws(()=>ai.collect(),/pending/);
+ assert.throws(()=>ai.submit(batch,{policy:new Float32Array(161).fill(NaN),wdl:new Float32Array(3)}),/evaluation/);
+ ai.submit(batch,{policy:new Float32Array(161),wdl:new Float32Array(3)});
+ const result=ai.result();assert.ok(result.move===null||game.analyze(result.move).ok);
+ const pending=ai.collect();ai.cancel();
+ if(pending.count)assert.throws(()=>ai.submit(pending,{policy:new Float32Array(pending.count*161),wdl:new Float32Array(pending.count*3)}),/Stale/);
+}
+// Terminal values are exact even when a neural evaluator strongly favours passing.
+for(const komi of [-6.5,0,6.5]){
+ const game=fixture('torus',7,[-1],komi);ai.start(aiPosition(game),{seed:3});
+ for(let k=0;k<30;k++){
+  const batch=ai.collect();if(!batch.count)continue;
+  const policy=new Float32Array(batch.count*161).fill(-10),wdl=new Float32Array(batch.count*3);
+  for(let b=0;b<batch.count;b++)policy[b*161+160]=10;
+  ai.submit(batch,{policy,wdl});
+ }
+ if(komi>0)assert.equal(ai.result().move,null);
+ if(komi<0)assert.notEqual(ai.result().move,null);
+ const result=ai.result();assert.ok(result.simulations>20);
+ assert.ok(Math.abs(result.policy.reduce((a,b)=>a+b,0)-1)<1e-5);
+}
+const ko=cases[6];ai.start(aiPosition(ko));const legal=ai.collect().legal;assert.equal(legal[24],0);ai.cancel();
+assert.throws(()=>ai.start({...aiPosition(ko),moves:[...aiPosition(ko).moves,24]}),/Illegal AI history/);
+assert.throws(()=>ai.collect(),/Start/);
+const ended=fixture('sphere',3,[-1,-1]);ai.start(aiPosition(ended));assert.equal(ai.collect().count,0);assert.equal(ai.result().move,null);
+ai.dispose();ai.dispose();assert.throws(()=>ai.start(aiPosition(ko)),/disposed/);
