diff --git a/dist/ai-v3-inference.js b/dist/ai-v3-inference.js
new file mode 100644
index 0000000..ad5c5af
--- /dev/null
+++ b/dist/ai-v3-inference.js
@@ -0,0 +1,99 @@
+export function adjacencyFor(topology){
+ const a=new Float32Array(160*160);
+ if(topology.neighbors.length>160)throw new Error('v3 board too large');
+ topology.neighbors.forEach((ns,p)=>ns.forEach(q=>{a[p*160+q]=1/ns.length;}));return a;
+}
+export function validateManifest(m){
+ if(!m||m.architecture!=='v3'||m.featureVersion!==1||m.points!==160||m.channels!==32||m.globals!==8||
+  m.hidden!==64||m.blocks!==6||m.status!=='experimental'||!Number.isInteger(m.parameters)||m.parameters<100000||m.parameters>150000||
+  !/^[a-f0-9]{64}$/.test(m.sha256)||m.model!=='model.onnx'||!(m.trainPositions>0))throw new Error('Incompatible v3 model manifest');
+}
+let runtimeBinary;
+async function loadRuntimeBinary(){
+ if(!runtimeBinary)runtimeBinary=(async()=>{
+  const r=await fetch(new URL('./vendor/onnxruntime/ort-wasm-simd-threaded.asyncify.wasm.gz',import.meta.url));
+  if(!r.ok)throw new Error('v3 inference runtime HTTP '+r.status);
+  const bytes=new Uint8Array(await r.arrayBuffer());
+  // Also tolerate servers that already decoded a gzip Content-Encoding.
+  return bytes[0]===0x1f&&bytes[1]===0x8b
+   ?new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer():bytes.buffer;
+ })().catch(error=>{runtimeBinary=null;throw error;});
+ return runtimeBinary;
+}
+export async function createV3Inference({
+ manifestURL=new URL('./models/v3/manifest.json',import.meta.url),backend='auto',batchSize=8,
+ importRuntime=()=>import('./vendor/onnxruntime/ort.webgpu.min.mjs'),
+}={}) {
+ if(!['auto','webgpu','wasm'].includes(backend)||![1,4,8].includes(batchSize))throw new Error('Invalid v3 inference options');
+ manifestURL=new URL(manifestURL,import.meta.url);
+ const response=await fetch(manifestURL);if(!response.ok)throw new Error('v3 model manifest HTTP '+response.status);
+ const manifest=await response.json();validateManifest(manifest);
+ const modelResponse=await fetch(new URL(manifest.model,manifestURL));if(!modelResponse.ok)throw new Error('v3 model HTTP '+modelResponse.status);
+ const bytes=new Uint8Array(await modelResponse.arrayBuffer());
+ const hash=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes)),v=>v.toString(16).padStart(2,'0')).join('');
+ if(hash!==manifest.sha256)throw new Error('v3 model checksum mismatch');
+ const ort=await importRuntime();
+ ort.env.wasm.wasmPaths=new URL('./vendor/onnxruntime/',import.meta.url).href;
+ ort.env.wasm.wasmBinary=await loadRuntimeBinary();
+ ort.env.wasm.numThreads=1; // No cross-origin isolation requirement.
+ let selected=backend==='auto'?(globalThis.navigator?.gpu?'webgpu':'wasm'):backend;
+ let session,disposed=false,evaluating=false,gpuInputs=null,lastAdjacency=null;
+ const storage={x:new Float32Array(batchSize*160*32),mask:new Float32Array(batchSize*160),global_features:new Float32Array(batchSize*8)};
+ function releaseGPU(){
+  if(gpuInputs){for(const t of Object.values(gpuInputs.feeds))t.dispose();for(const b of gpuInputs.buffers)b.destroy();gpuInputs=null;}
+  lastAdjacency=null;
+ }
+ function gpuFeeds(adjacency){
+  const device=ort.env.webgpu.device;
+  if(!gpuInputs){
+   const feeds={},buffers=[];
+   for(const [key,dims,length]of [['x',[batchSize,160,32],batchSize*160*32],['mask',[batchSize,160,1],batchSize*160],
+    ['global_features',[batchSize,8],batchSize*8],['adjacency',[1,160,160],160*160]]){
+    const buffer=device.createBuffer({size:length*4,usage:GPUBufferUsage.STORAGE|GPUBufferUsage.COPY_DST});
+    buffers.push(buffer);feeds[key]=ort.Tensor.fromGpuBuffer(buffer,{dataType:'float32',dims});
+   }
+   gpuInputs={feeds,buffers};
+  }
+  for(const [key,values]of Object.entries(storage))device.queue.writeBuffer(gpuInputs.feeds[key].gpuBuffer,0,values);
+  if(lastAdjacency!==adjacency){device.queue.writeBuffer(gpuInputs.feeds.adjacency.gpuBuffer,0,adjacency);lastAdjacency=adjacency;}
+  return gpuInputs.feeds;
+ }
+ async function open(provider){return ort.InferenceSession.create(bytes,{executionProviders:[provider],freeDimensionOverrides:{batch:batchSize}});}
+ try{session=await open(selected);}catch(error){if(backend!=='auto'||selected==='wasm')throw error;selected='wasm';session=await open(selected);}
+ return {
+  get backend(){return selected;},manifest,batchSize,
+  async evaluate(request,adjacency,{auxiliary=false}={}){
+   if(disposed)throw new Error('v3 inference disposed');
+   if(evaluating)throw new Error('v3 inference already running');
+   const count=request.count;
+   if(!Number.isInteger(count)||count<1||count>batchSize||adjacency.length!==160*160||request.x.length!==count*160*32||
+    request.mask.length!==count*160||request.global_features.length!==count*8)throw new Error('Invalid v3 features');
+   evaluating=true;
+   let gpu=selected==='webgpu',feeds,outputs;
+   try{
+   for(const [key,values]of Object.entries(storage)){values.fill(0);values.set(request[key]);}
+   const cpuFeeds=()=>({x:new ort.Tensor('float32',storage.x,[batchSize,160,32]),
+    adjacency:new ort.Tensor('float32',adjacency,[1,160,160]),mask:new ort.Tensor('float32',storage.mask,[batchSize,160,1]),
+    global_features:new ort.Tensor('float32',storage.global_features,[batchSize,8])});
+   try{feeds=gpu?gpuFeeds(adjacency):cpuFeeds();outputs=await session.run(feeds,auxiliary?['policy','wdl','score','ownership']:['policy','wdl']);}
+   catch(error){
+    if(backend!=='auto'||selected==='wasm')throw error;
+    releaseGPU();await session.release();selected='wasm';session=await open(selected);gpu=false;feeds=cpuFeeds();
+    outputs=await session.run(feeds,auxiliary?['policy','wdl','score','ownership']:['policy','wdl']);
+   }
+   const result={};
+   for(const [key,tensor] of Object.entries(outputs)){
+    const width=key==='policy'?161:key==='wdl'?3:key==='ownership'?160*3:1;
+    result[key]=Float32Array.from(tensor.data.subarray(0,count*width));
+    if(!result[key].every(Number.isFinite))throw new Error('Nonfinite v3 inference');
+   }
+   return result;
+   }finally{
+    for(const t of Object.values(outputs??{}))t.dispose();
+    if(!gpu)for(const t of Object.values(feeds??{}))t.dispose();
+    evaluating=false;
+   }
+  },
+  async dispose(){if(!disposed){disposed=true;releaseGPU();await session.release();}}
+ };
+}
diff --git a/dist/ai-v3-search.js b/dist/ai-v3-search.js
new file mode 100644
index 0000000..2fee12b
--- /dev/null
+++ b/dist/ai-v3-search.js
@@ -0,0 +1,53 @@
+// Feature ABI v1. The independent v2 module remains the production fallback.
+import {validateAIPosition} from './ai-position.js';
+export const V3={points:160,channels:32,globals:8,actions:161,batch:8};
+export async function createV3Search({load=async()=>{
+ const r=await fetch(new URL('./ai-v3.wasm',import.meta.url));
+ if(!r.ok)throw new Error('v3 WASM HTTP '+r.status);return r.arrayBuffer();
+}}={}) {
+ const {instance}=await WebAssembly.instantiate(await load(),{}),api=instance.exports;
+ if(api.v3_version()!==1)throw new Error('Incompatible v3 feature ABI');
+ let ptr=0,capacity=0,generation=0,pending=null,disposed=false,position=null;
+ function allocate(words){
+  if(words>capacity){if(ptr)api.v3_free(ptr,capacity);capacity=Math.max(words,10000);ptr=api.v3_alloc(capacity);if(!ptr)throw new Error('v3 allocation failed');}
+ }
+ function check(){if(disposed)throw new Error('v3 search disposed');}
+ function read(kind,length,Type=Float32Array){return new Type(api.memory.buffer,api.v3_buffer(kind),length).slice();}
+ return {
+  start(next,{seed=0}={}){
+   check();validateAIPosition(next);api.v3_cancel();pending=null;generation++;position=null;
+   allocate(Math.max(1,next.moves.length));new Int32Array(api.memory.buffer,ptr,next.moves.length).set(next.moves);
+   const result=api.v3_start(next.kind==='sphere'?0:1,next.size,next.komi,ptr,next.moves.length,seed>>>0);
+   if(result)throw new Error(result===-3?'Illegal AI history':'Invalid v3 position');
+   position={...next,moves:Int32Array.from(next.moves)};
+  },
+  collect(batch=V3.batch){
+   check();if(!position)throw new Error('Start v3 search first');if(pending)throw new Error('v3 batch still pending');
+   if(!Number.isInteger(batch)||batch<1||batch>8)throw new Error('Invalid v3 batch size');
+   const count=api.v3_collect(batch);if(count<0)throw new Error('v3 collect failed');
+   const request={generation,count,ids:read(4,count,Uint32Array),x:read(0,count*160*32),
+    global_features:read(1,count*8),mask:read(2,count*160),legal:read(3,count*161)};
+   if(count)pending={generation,ids:request.ids.slice()};return request;
+  },
+  submit(request,{policy,wdl}){
+   check();if(!pending||request.generation!==generation||request.generation!==pending.generation||
+    request.ids.length!==pending.ids.length||request.ids.some((id,k)=>id!==pending.ids[k]))throw new Error('Stale v3 batch');
+   const count=pending.ids.length;
+   if(policy?.length!==count*161||wdl?.length!==count*3||!policy.every(Number.isFinite)||!wdl.every(Number.isFinite))throw new Error('Invalid v3 evaluation');
+   allocate(count*(163));
+   new Uint32Array(api.memory.buffer,ptr,count).set(pending.ids);
+   const values=new Float32Array(api.memory.buffer,ptr+count*4,count*162);
+   for(let b=0;b<count;b++){
+    values.set(policy.subarray(b*161,(b+1)*161),b*162);
+    const w=wdl.subarray(b*3,b*3+3),max=Math.max(...w),exp=Array.from(w,v=>Math.exp(v-max));
+    values[b*162+161]=(exp[0]-exp[2])/(exp[0]+exp[1]+exp[2]);
+   }
+   if(api.v3_submit(ptr,ptr+count*4,count))throw new Error('v3 rejected evaluation');
+   pending=null;
+  },
+  result(){check();if(!position)throw new Error('Start v3 search first');const move=api.v3_best();
+   if(move< -1)throw new Error('v3 has no position');return {move:move===-1?null:move,policy:read(5,161),simulations:api.v3_completed()};},
+  cancel(){check();generation++;pending=null;api.v3_cancel();},
+  dispose(){if(disposed)return;api.v3_cancel();if(ptr)api.v3_free(ptr,capacity);ptr=0;disposed=true;}
+ };
+}
diff --git a/dist/ai-v3.js b/dist/ai-v3.js
new file mode 100644
index 0000000..84a491d
--- /dev/null
+++ b/dist/ai-v3.js
@@ -0,0 +1,44 @@
+import {createTopology} from './engine.js';
+import {createV3Search} from './ai-v3-search.js';
+import {createV3Inference,adjacencyFor} from './ai-v3-inference.js';
+
+export async function createV3AI(options={}){
+ const search=await createV3Search(options);
+ let inference;
+ try{
+  inference=await createV3Inference(options);
+  // Compile kernels during initialization; the Worker keeps serving v2 meanwhile.
+  const warm={kind:'torus',size:7,komi:6.5,moves:new Int32Array()};
+  search.start(warm);const leaves=search.collect(1);
+  search.submit(leaves,await inference.evaluate(leaves,adjacencyFor(createTopology('torus',7))));
+  search.cancel();
+ }catch(error){search.dispose();await inference?.dispose();throw error;}
+ let cancelled=0,busy=false;
+ return {
+  get backend(){return 'v3-'+inference.backend;},
+  async chooseMove(position,{seed=0,budgetMs=300,maxSimulations=4096}={}){
+   if(busy)throw new Error('v3 search already running');
+   if(!Number.isFinite(budgetMs)||budgetMs<=0||!Number.isInteger(maxSimulations)||maxSimulations<1)throw new Error('Invalid v3 search budget');
+   busy=true;const generation=cancelled;
+   try{
+    search.start(position,{seed});const adjacency=adjacencyFor(createTopology(position.kind,position.size));
+    const start=performance.now();let batches=0,lastBatchMs=0;
+    while(search.result().simulations<maxSimulations){
+     const remaining=budgetMs-(performance.now()-start);
+     if(batches&&remaining<Math.max(1,lastBatchMs))break;
+     if(generation!==cancelled)throw new Error('v3 cancelled');
+     const leaves=search.collect(inference.batchSize);
+     if(!leaves.count){if(!search.result().simulations)break;await new Promise(r=>setTimeout(r,0));continue;}
+     const batchStart=performance.now();const evaluation=await inference.evaluate(leaves,adjacency);
+     if(generation!==cancelled)throw new Error('v3 cancelled');
+     search.submit(leaves,evaluation);batches++;lastBatchMs=performance.now()-batchStart;
+     // Let cancellation messages run between batches.
+     await new Promise(r=>setTimeout(r,0));
+    }
+    return {...search.result(),backend:this.backend,elapsedMs:performance.now()-start,batches};
+   }finally{search.cancel();busy=false;}
+  },
+  cancel(){cancelled++;search.cancel();},
+  async dispose(){cancelled++;search.dispose();await inference.dispose();}
+ };
+}
