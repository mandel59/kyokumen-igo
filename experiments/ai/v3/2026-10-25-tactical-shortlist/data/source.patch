+        for p in 0..n {
+            if legal[p] && features.x[p*gnn::CHANNELS+29]>=0.25 {
+                scores[p]=(features.x[p*gnn::CHANNELS+28].powi(2)*n as f32).round() as u32;
+            }
+        }
