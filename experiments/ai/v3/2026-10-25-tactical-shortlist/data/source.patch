+            if game.board[p]!=game.turn || seen[p] || features.x[p*gnn::CHANNELS+3]<0.5 {continue;}
+            if scratch.group(&game.board,&game.topology.neighbors,p)!=1 {continue;}
+            let size=scratch.stones.len() as u32;let mut liberty=None;
+            for &q in &scratch.stones {
+                seen[q]=true;
+                for &r in &game.topology.neighbors[q] {if game.board[r]==0 {liberty=Some(r);}}
+            }
