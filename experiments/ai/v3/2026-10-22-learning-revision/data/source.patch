diff --git a/tools/ai-gnn/annotate-corpus.mjs b/tools/ai-gnn/annotate-corpus.mjs
new file mode 100644
index 0000000..c6e8c70
--- /dev/null
+++ b/tools/ai-gnn/annotate-corpus.mjs
@@ -0,0 +1,63 @@
+// Recover actual bootstrap moves from consecutive boards, then verify every root by replay.
+import assert from 'node:assert/strict';
+import {createReadStream,createWriteStream,readFileSync,writeFileSync} from 'node:fs';
+import {createGunzip,createGzip} from 'node:zlib';
+import {createInterface} from 'node:readline';
+import {once} from 'node:events';
+import {createV3Search} from '../../dist/ai-v3-search.js';
+import {Game,createTopology} from '../../dist/engine.js';
+import {aiPosition} from '../../dist/ai-position.js';
+const args=process.argv.slice(2),arg=(k,d)=>args.includes(k)?args[args.indexOf(k)+1]:d;
+const at=args.indexOf('--input'),end=args.indexOf('--output'),inputs=args.slice(at+1,end);
+const output=arg('--output'),reportPath=arg('--report');
+if(at<0||end<=at+1||!output||inputs.includes(output))throw new Error('Expected --input FILES --output FILE [--report FILE]');
+const file=createWriteStream(output),out=output.endsWith('.gz')?createGzip():file;
+if(out!==file)out.pipe(file);
+const search=await createV3Search({load:async()=>readFileSync(new URL('../../dist/ai-v3.wasm',import.meta.url))});
+const report={schemaVersion:1,inputs,positions:0,games:0,decisions:{},recoveredTeacherDiversifications:0,verifiedRoots:0,archivedCertificates:0};
+const board=r=>Array.from({length:r.x.length/32},(_,p)=>r.x[p*32]?(r.global[6]===1?1:2):r.x[p*32+1]?(r.global[6]===1?2:1):0);
+async function write(r){if(!out.write(JSON.stringify(r)+'\n'))await once(out,'drain');report.positions++;report.decisions[r.decisionReason]=(report.decisions[r.decisionReason]??0)+1;}
+async function annotate(rows){
+ if(!rows.length)return;
+ if(rows[0].variant==='certified-cleanup'){
+  for(const r of rows){assert.ok(r.certificateMargin>0);await write({...r,decisionReason:'certified-loss',decisionVerification:'archived-certificate',policyEligible:false});report.archivedCertificates++;}
+  return;
+ }
+ const first=rows[0],n=first.x.length/32,sign=first.global[6]===1?1:-1;
+ const game=new Game(createTopology(first.kind,first.size),Math.round(-first.global[0]*n*sign*2)/2);
+ for(let i=0;i<rows.length;i++){
+  const r=rows[i],before=board(r);assert.deepEqual(Array.from(game.board),before,'Replayed board differs from stored features');
+  assert.equal(game.turn,r.global[6]===1?1:2);
+  search.start(aiPosition(game));const root=search.collect(1),result=search.result();search.cancel();
+  assert.equal(root.count,1);
+  assert.ok(r.x.every((v,k)=>Math.abs(v-root.x[k])<2e-5),'Feature/history mismatch');
+  assert.ok(r.global.every((v,k)=>Math.abs(v-root.global_features[k])<2e-6),'Global feature mismatch');
+  assert.deepEqual(Array.from(root.legal,Boolean),r.legal,'Legal mask mismatch');
+  let action=r.playedAction??r.action;
+  if(r.source!=='selfplay'&&i+1<rows.length){
+   const after=board(rows[i+1]),added=after.flatMap((v,p)=>!before[p]&&v===game.turn?[p]:[]);
+   assert.ok(added.length<=1);action=added[0]??160;
+   if(action!==r.action)report.recoveredTeacherDiversifications++;
+  }
+  const annotated={...r,positionId:r.positionId??r.gameId+':'+i,ply:i,playedAction:action,
+   decisionReason:result.decisionReason,decisionVerification:'full-history-replay',policyEligible:result.decisionReason!=='certified-loss'};
+  await write(annotated);report.verifiedRoots++;
+  assert.ok((action===160?game.pass():game.play(action)).ok,'Recovered move must be legal');
+ }
+ assert.equal(game.ended,true,'Only completed games can supply labels');
+ report.games++;
+}
+try{
+ for(const path of inputs){
+  let group=[];
+  const stream=createReadStream(path),input=path.endsWith('.gz')?stream.pipe(createGunzip()):stream;
+  for await(const line of createInterface({input,crlfDelay:Infinity})){
+   if(!line.trim())continue;const r=JSON.parse(line),key=r.sequenceId??r.gameId;
+   if(group.length&&key!==(group[0].sequenceId??group[0].gameId)){await annotate(group);group=[];}
+   group.push(r);
+  }
+  await annotate(group);console.log('Annotated',path,report.positions);
+ }
+}finally{search.dispose();out.end();await once(file,'finish');}
+if(reportPath)writeFileSync(reportPath,JSON.stringify(report,null,2)+'\n');
+console.log(JSON.stringify(report));
diff --git a/tools/ai-gnn/archive-study.mjs b/tools/ai-gnn/archive-study.mjs
new file mode 100644
index 0000000..d3afe28
--- /dev/null
+++ b/tools/ai-gnn/archive-study.mjs
@@ -0,0 +1,52 @@
+// Preserve changed sources and archive large JSON traces without changing their contents.
+import {readFileSync,writeFileSync,mkdirSync,existsSync,unlinkSync,statSync} from 'node:fs';
+import {resolve,relative,join,isAbsolute} from 'node:path';
+import {spawnSync} from 'node:child_process';
+import {createHash} from 'node:crypto';
+import {gzipSync,gunzipSync} from 'node:zlib';
+const directory='experiments/ai/v3/2026-10-22-learning-revision',data=directory+'/data',root=resolve('.');
+const baseCommit='69caea83f6d32e1b6d3cddba70f0b49916b68b40';
+const hash=b=>createHash('sha256').update(b).digest('hex');
+const git=args=>{const r=spawnSync('git',args,{encoding:'utf8',maxBuffer:64*1024*1024});if(r.status!==0)throw new Error(r.stderr);return r.stdout;};
+const untracked=new Set(git(['ls-files','--others','--exclude-standard']).trim().split('\n'));
+const paths=new Set([...git(['diff','--name-only',baseCommit]).trim().split('\n'),...untracked]);
+const inScope=p=>/^tools\/ai-gnn\/[^/]+\.(mjs|py|md|toml|json|lock)$/.test(p)||
+ ['tools/ai-tuner/src/mcts.rs','tools/ai-tuner/src/gnn-wasm.rs','tools/ai-tuner/check-experiments.mjs',
+  'experiments/ai/catalog.json','experiments/ai/README.md',directory+'/README.md',
+  'THIRD_PARTY.md','docs/third-party/catalog.json','docs/ai/architectures/v3.md',
+  'dist/third-party-catalog.json','dist/third-party.html','dist/licenses/index.html','tests/fixtures/ai/v3-golden.json',directory+'/plan.json'].includes(p)||
+ p.startsWith('dist/ai-v3')||p.startsWith('dist/models/v3/');
+const sources=[];
+for(const path of [...paths].sort()){
+ if(!path||!inScope(path)||!existsSync(path)||!statSync(path).isFile())continue;
+ const bytes=readFileSync(path),snapshot=join(data,'source',path);mkdirSync(resolve(snapshot,'..'),{recursive:true});writeFileSync(snapshot,bytes);
+ sources.push({path,sha256:hash(bytes),snapshot});
+}
+const artifacts=[];
+for(const name of['search-s1','search-s2']){
+ const path=data+'/'+name+'.json';
+ if(!existsSync(path)){
+  if(existsSync(path+'.gz')){
+   const packed=readFileSync(path+'.gz'),bytes=gunzipSync(packed);
+   artifacts.push({path:path+'.gz',sha256:hash(packed),uncompressedSha256:hash(bytes),bytes:bytes.length,compressedBytes:packed.length});
+  }
+  continue;
+ }
+ const bytes=readFileSync(path),report=JSON.parse(bytes);
+ if(report.summary?.games!==96||report.summary?.completed!==96)throw new Error('Cannot archive an unfinished comparison');
+ const packed=gzipSync(bytes),destination=path+'.gz';writeFileSync(destination,packed);
+ if(hash(gunzipSync(readFileSync(destination)))!==hash(bytes))throw new Error('Archive verification failed');
+ artifacts.push({path:destination,sha256:hash(packed),uncompressedSha256:hash(bytes),bytes:bytes.length,compressedBytes:packed.length});
+ // This is a single generated trace, never a recursive deletion or a user input file.
+ const resolved=resolve(path),within=relative(resolve(data),resolved);
+ if(!within||within.startsWith('..')||isAbsolute(within)||!statSync(resolved).isFile())throw new Error('Trace outside experiment');
+ unlinkSync(resolved);
+}
+let patch=git(['diff','--binary',baseCommit,'--',...sources.map(s=>s.path)]);
+for(const source of sources)if(untracked.has(source.path)){
+ const result=spawnSync('git',['diff','--no-index','--binary','--','/dev/null',source.path],{encoding:'utf8',maxBuffer:64*1024*1024});
+ if(![0,1].includes(result.status))throw new Error(result.stderr||String(result.error));patch+=result.stdout;
+}
+writeFileSync(data+'/source.patch',patch);
+writeFileSync(data+'/source-manifest.json',JSON.stringify({schemaVersion:1,baseCommit,captured:new Date().toISOString(),patch:{path:data+'/source.patch',sha256:hash(Buffer.from(patch))},sources,compressedArtifacts:artifacts},null,2)+'\n');
+console.log(JSON.stringify({sourceFiles:sources.length,compressedArtifacts:artifacts}));
diff --git a/tools/ai-gnn/audit-teacher-targets.mjs b/tools/ai-gnn/audit-teacher-targets.mjs
new file mode 100644
index 0000000..bb4123b
--- /dev/null
+++ b/tools/ai-gnn/audit-teacher-targets.mjs
@@ -0,0 +1,36 @@
+// Audit the frozen v2 labels against the v3 rule mask; never modifies study labels.
+import assert from 'node:assert/strict';
+import {createReadStream,readFileSync,writeFileSync} from 'node:fs';
+import {createGunzip} from 'node:zlib';
+import {createInterface} from 'node:readline';
+import {Game,createTopology} from '../../dist/engine.js';
+import {aiPosition} from '../../dist/ai-position.js';
+import {createV3Search} from '../../dist/ai-v3-search.js';
+const data='experiments/ai/v3/2026-10-22-learning-revision/data';
+const search=await createV3Search({load:async()=>readFileSync('dist/ai-v3.wasm')});
+const report={schemaVersion:1,role:'Rule-mask audit before candidate training',normalTargets:0,blockedTargets:0,certifiedExcluded:0,groups:{},examples:[],blockedPositionIds:[]};
+let game,id;
+try{
+ for await(const line of createInterface({input:createReadStream(data+'/teacher-annotated.jsonl.gz').pipe(createGunzip()),crlfDelay:Infinity})){
+  const r=JSON.parse(line),n=r.x.length/32;
+  if(id!==r.gameId){if(game)assert.equal(game.ended,true);game=new Game(createTopology(r.kind,r.size),Math.round(-r.global[0]*n*2)/2);id=r.gameId;}
+  if(r.decisionReason==='certified-loss')report.certifiedExcluded++;
+  else{
+   search.start(aiPosition(game));const request=search.collect(1);
+   assert.equal(request.count,1);
+   search.submit(request,{policy:new Float32Array(161),wdl:new Float32Array(3)});
+   const result=search.result();assert.equal(result.provenLoss,false);
+   const blocked=result.policy[r.action]===0;
+   report.normalTargets++;if(blocked)report.blockedTargets++;
+   const phase=r.ply<n/2?'opening':r.ply<n?'middle':'late',key=r.kind+r.size+'/'+phase;
+   const group=report.groups[key]??={normalTargets:0,blockedTargets:0};group.normalTargets++;group.blockedTargets+=Number(blocked);
+   if(blocked&&report.examples.length<100)report.examples.push({gameId:r.gameId,board:r.kind+r.size,ply:r.ply,action:r.action});
+   if(blocked)report.blockedPositionIds.push(r.positionId);
+  }
+  const action=r.playedAction;assert.ok((action===160?game.pass():game.play(action)).ok);
+ }
+ if(game)assert.equal(game.ended,true);
+}finally{search.dispose();}
+report.blockedFraction=report.blockedTargets/report.normalTargets;
+writeFileSync(data+'/teacher-target-audit.json',JSON.stringify(report,null,2)+'\n');
+console.log(JSON.stringify({normalTargets:report.normalTargets,blockedTargets:report.blockedTargets,blockedFraction:report.blockedFraction}));
diff --git a/tools/ai-gnn/browser-match.mjs b/tools/ai-gnn/browser-match.mjs
